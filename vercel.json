# Vercel deployment configuration for Proptify

{
  "buildCommand": "cd backend && npm run build && cd ../frontend && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "frontend/.next",
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_STELLAR_NETWORK",
    "NEXT_PUBLIC_STELLAR_RPC_URL",
    "NEXT_PUBLIC_HORIZON_URL",
    "STELLAR_NETWORK",
    "STELLAR_RPC_URL",
    "STELLAR_NETWORK_PASSPHRASE",
    "STELLAR_HORIZON_URL",
    "ADMIN_SECRET_KEY",
    "ADMIN_PUBLIC_KEY",
    "DATABASE_URL",
    "JWT_SECRET",
    "PORT",
    "NODE_ENV"
  ]
}
